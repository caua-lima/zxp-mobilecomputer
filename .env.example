# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis em
# Vercel > Settings > Environment Variables (produção).
#
# ⚠️ Nenhuma tem NEXT_PUBLIC_ no nome, e isso é proposital: variável com
# NEXT_PUBLIC_ vai embutida no JavaScript que o navegador baixa. Tudo aqui é
# segredo e só pode existir no servidor.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Acesso ao painel (você, no navegador) ───────────────────────────────
# A senha que você digita em /entrar.
SENHA=

# Assina o cookie de sessão. Qualquer string longa e aleatória serve —
# trocar esta variável desconecta todos os aparelhos.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# ── Acesso do CLI (o `nuvem push`) ──────────────────────────────────────
# Token que o computador usa pra sincronizar. Gere do mesmo jeito acima.
TOKEN_SYNC=
